Cell[CellGroupData[{

Cell["Example of Numerical Solution", "Section"],

Cell["\<\
We can now use the previous results as the starting point and obtain a \
numerical solution.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"f", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "5"}], "}"}]}], "]"}], "/.", 
   "ThirdOrderSol"}], "//", "Normal"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"A", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "5"}], "}"}]}], "]"}], "/.", 
   "ThirdOrderSol"}], "//", "Normal"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"\[Eta]", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "4"}], "}"}]}], "]"}], "/.", 
   "ThirdOrderSol"}], "//", "Normal"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fSeries", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"z", " ", "f1H"}], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["z", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "72"}], "+", 
       SuperscriptBox["f1H", "2"]}], ")"}]}], 
    RowBox[{"3", " ", "f1H"}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["z", "5"], " ", 
     RowBox[{"(", 
      RowBox[{"3424", "-", 
       RowBox[{"120", " ", 
        SuperscriptBox["f1H", "2"]}], "+", 
       SuperscriptBox["f1H", "4"]}], ")"}]}], 
    RowBox[{"5", " ", 
     SuperscriptBox["f1H", "3"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ASeries", "[", "z_", "]"}], ":=", 
  RowBox[{"AH", "+", 
   FractionBox[
    RowBox[{"24", " ", 
     SuperscriptBox["z", "2"]}], 
    SuperscriptBox["f1H", "2"]], "+", 
   FractionBox[
    RowBox[{"16", " ", 
     SuperscriptBox["z", "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "52"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["f1H", "2"]}]}], ")"}]}], 
    RowBox[{"3", " ", 
     SuperscriptBox["f1H", "4"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]Series", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox["3"], " ", "\[Pi]"}], "2"], "-", 
   FractionBox[
    RowBox[{"8", " ", 
     SqrtBox["3"], " ", "z"}], "f1H"], "-", 
   FractionBox[
    RowBox[{"8", " ", 
     SuperscriptBox["z", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "104"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["f1H", "2"]}]}], ")"}]}], 
    RowBox[{"3", " ", 
     SqrtBox["3"], " ", 
     SuperscriptBox["f1H", "3"]}]]}]}]}], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NumericalSolAdS", "[", 
   RowBox[{
    RowBox[{"f1_", "?", "NumericQ"}], ",", 
    RowBox[{"A0_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", "=", 
      SuperscriptBox["10", 
       RowBox[{"-", "8"}]]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FinalEq1", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FinalEq2", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FinalEq4", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"f", "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{"fSeries", "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "'"}], "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{
           RowBox[{"fSeries", "'"}], "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Eta]", "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{"\[Eta]Series", "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Eta]", "'"}], "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{
           RowBox[{"\[Eta]Series", "'"}], "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"A", "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{"ASeries", "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "'"}], "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{
           RowBox[{"ASeries", "'"}], "[", "\[Epsilon]", "]"}]}]}], 
        "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AH", "->", "A0"}], ",", 
         RowBox[{"f1H", "->", "f1"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[Eta]", ",", "f", ",", "A"}], "}"}], "\[IndentingNewLine]", ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Epsilon]"}], ",", 
        RowBox[{"-", "\[Epsilon]"}]}], "}"}], "\[IndentingNewLine]", ",", 
      RowBox[{"WorkingPrecision", "->", "50"}], ",", 
      RowBox[{"AccuracyGoal", "->", "20"}], ",", 
      RowBox[{"PrecisionGoal", "->", "20"}]}], "\[IndentingNewLine]", "]"}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NumericalSoldS", "[", 
