(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell["Preamble", "Chapter"],

Cell["\<\
We set up the ansatz of our metric and our potential for a general AdS length \
(L)\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coord", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "\[Rho]", ",", "x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{
        RowBox[{"-", 
         RowBox[{"f", "[", "\[Rho]", "]"}]}], 
        RowBox[{"Exp", "[", 
         RowBox[{"2", 
          RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}]}], "0", "0", "0"},
      {"0", 
       FractionBox["1", 
        RowBox[{"f", "[", "\[Rho]", "]"}]], "0", "0"},
      {"0", "0", 
       RowBox[{"Exp", "[", 
        RowBox[{"2", 
         RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}], "0"},
      {"0", "0", "0", 
       RowBox[{"Exp", "[", 
        RowBox[{"2", 
         RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}]}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "\[Eta]_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[IndentingNewLine]", "6"}], 
      SuperscriptBox["L", "2"]]}], 
    RowBox[{"Cos", "[", 
     FractionBox["\[Eta]", 
      SqrtBox["3"]], "]"}]}]}], ";"}]}], "Input"],

Cell["We load our GR package", "Text"],

Cell[BoxData[
 RowBox[{"<<", 
  "/Users/StringAndComp/Downloads/Repos/SuperGrav/supergrav.wl"}]], "Input"],

Cell["We load our general Utilities package", "Text"],

Cell[BoxData[
 RowBox[{"<<", 
  "/Users/StringAndComp/Downloads/Repos/MyBasics/MyBasics.wl"}]], "Input"],

Cell["We obtain the equations of motion", "Text"],

Cell[BoxData[{
 RowBox[{"EinsteinEq", "=", 
  RowBox[{"RicciTensor", "+", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"TensorProduct", "[", 
     RowBox[{
      RowBox[{"partial", "[", 
       RowBox[{"\[Eta]", "[", "\[Rho]", "]"}], "]"}], ",", 
      RowBox[{"partial", "[", 
       RowBox[{"\[Eta]", "[", "\[Rho]", "]"}], "]"}]}], "]"}]}], "-", 
   RowBox[{
    FractionBox["1", "2"], "metric", "*", 
    RowBox[{"V", "[", 
     RowBox[{"\[Eta]", "[", "\[Rho]", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ScalarEq", "=", 
  RowBox[{
   RowBox[{"scalarLaplacian", "[", 
    RowBox[{"\[Eta]", "[", "\[Rho]", "]"}], "]"}], "+", 
   RowBox[{
    RowBox[{"V", "'"}], "[", 
    RowBox[{"\[Eta]", "[", "\[Rho]", "]"}], "]"}]}]}]}], "Input"],

Cell[BoxData[{
 RowBox[{"Einsteintt", "=", 
  RowBox[{
   RowBox[{"2", 
    FractionBox["1", 
     RowBox[{"f", "[", "\[Rho]", "]"}]], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}], 
    RowBox[{"EinsteinEq", "[", 
     RowBox[{"[", 
      RowBox[{"t", ",", "t"}], "]"}], "]"}]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Einstein\[Rho]\[Rho]", "=", 
  RowBox[{
   RowBox[{"2", 
    RowBox[{"f", "[", "\[Rho]", "]"}], 
    RowBox[{"EinsteinEq", "[", 
     RowBox[{"[", 
      RowBox[{"\[Rho]", ",", "\[Rho]"}], "]"}], "]"}]}], "//", 
   "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Einsteinxx", "=", 
  RowBox[{
   RowBox[{"2", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}], 
    RowBox[{"EinsteinEq", "[", 
     RowBox[{"[", 
      RowBox[{"x", ",", "x"}], "]"}], "]"}]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Einsteinyy", "=", 
  RowBox[{
   RowBox[{"2", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}], 
    RowBox[{"EinsteinEq", "[", 
     RowBox[{"[", 
      RowBox[{"y", ",", "y"}], "]"}], "]"}]}], "//", 
   "FullSimplify"}]}]}], "Input"],

Cell["We simplify these 5 equations into 4 independent ones", "Text"],

Cell[BoxData[{
 RowBox[{"Eq1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"f", "[", "\[Rho]", "]"}]]}], 
    RowBox[{"(", 
     RowBox[{"Einsteintt", "+", "Einstein\[Rho]\[Rho]"}], ")"}]}], "//", 
   "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Eq2", "=", 
  RowBox[{
   RowBox[{"Einsteintt", "+", "Einsteinxx"}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Eq3", "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"Einsteinxx", "+", "Einstein\[Rho]\[Rho]", "+", "Einsteintt"}], 
     ")"}]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"Eq4", "=", 
  RowBox[{
   FractionBox["ScalarEq", 
    RowBox[{"f", "[", "\[Rho]", "]"}]], "//", "FullSimplify"}]}]}], "Input"],

Cell["\<\
The second equation is a exact derivative that gives us a constant of motion\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"3", 
       RowBox[{"A", "[", "\[Rho]", "]"}]}], "]"}], 
     RowBox[{
      RowBox[{"f", "'"}], "[", "\[Rho]", "]"}]}], ",", "\[Rho]"}], "]"}], "//",
   "Simplify"}]], "Input"],

Cell["We use equation 1 to turn equation 3 into a constraint", "Text"],

Cell[BoxData[{
 RowBox[{"AintoEta", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"Eq1", "==", "0"}], ",", 
     RowBox[{
      RowBox[{"A", "''"}], "[", "\[Rho]", "]"}]}], "]"}], "//", 
   "Flatten"}]}], "\[IndentingNewLine]", 
 RowBox[{"Constraint", "=", 
  RowBox[{"Eq3", "/.", "AintoEta"}]}]}], "Input"],

Cell["We make a consistency check", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Eq1", "==", "0"}], ",", 
       RowBox[{"Eq2", "==", "0"}], ",", 
       RowBox[{"Eq4", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "''"}], "[", "\[Rho]", "]"}], ",", 
       RowBox[{
        RowBox[{"A", "''"}], "[", "\[Rho]", "]"}], ",", 
       RowBox[{
        RowBox[{"\[Eta]", "''"}], "[", "\[Rho]", "]"}]}], "}"}]}], "]"}], "//",
    "Flatten"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"Constraint", ",", "\[Rho]"}], "]"}], "/.", "%"}], "//", 
  "Simplify"}]}], "Input"]}, Closed]],

Cell[CellGroupData[{

Cell["Resolution", "Chapter"],

Cell[CellGroupData[{

Cell["Global Equation", "Section"],

Cell[TextData[{
 "We change into a compact variable: ",
 Cell[BoxData[
  RowBox[{"\[Rho]", "=", 
   RowBox[{"\[Rho]h", "+", 
    RowBox[{"L", " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", "z"}], 
       RowBox[{"1", "-", "z"}]], "]"}]}]}]}]]]
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", ">", "0"}], ",", 
      RowBox[{"\[Rho]", "\[Element]", "Reals"}], ",", 
      RowBox[{"\[Rho]h", "\[Element]", "Reals"}]}], "}"}], ",", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"\[Rho]", "==", 
       RowBox[{"\[Rho]h", "+", 
        RowBox[{"L", " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"1", "+", "z"}], 
           RowBox[{"1", "-", "z"}]], "]"}]}]}]}], ",", "z"}], "]"}]}], "]"}], 
  "//", "Flatten"}]], "Input"],

Cell[TextData[{
 "In all of our cases we are going to consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]h", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm]
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CompactVariableTrans", "=", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", "->", 
     RowBox[{"L", " ", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", "z"}], 
        RowBox[{"1", "-", "z"}]], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CompactVariableFunc", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Eta]", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"\[Rho]", ",", 
        RowBox[{"\[Eta]", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "-", "1"}], 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "+", "1"}]], "]"}]}], "]"}]}], ",", 
     RowBox[{"f", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"\[Rho]", ",", 
        RowBox[{"f", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "-", "1"}], 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "+", "1"}]], "]"}]}], "]"}]}], ",", 
     RowBox[{"A", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"\[Rho]", ",", 
        RowBox[{"A", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "-", "1"}], 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox["\[Rho]", "L"]], "+", "1"}]], "]"}]}], "]"}]}]}], 
    "}"}]}], ";"}]}], "Input"],

Cell[BoxData[{
 RowBox[{"CompactEq1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Eq1", "/.", "CompactVariableFunc"}], "/.", 
    "CompactVariableTrans"}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"CompactEq2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Eq2", "/.", "CompactVariableFunc"}], "/.", 
    "CompactVariableTrans"}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"CompactConstraint", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Constraint", "/.", "CompactVariableFunc"}], "/.", 
    "CompactVariableTrans"}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"CompactEq4", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "\[Rho]", "]"}], "Eq4"}], "/.", 
     "CompactVariableFunc"}], "/.", "CompactVariableTrans"}], "//", 
   "FullSimplify"}]}]}], "Input"],

Cell["After some clearing, these are the final equations", "Text"],

Cell[BoxData[{
 RowBox[{"FinalEq1", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"CompactEq1", "/", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"CompactEq1", ",", 
       RowBox[{
        RowBox[{"A", "''"}], "[", "z", "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "''"}], "[", "z", "]"}], ",", 
      RowBox[{
       RowBox[{"A", "'"}], "[", "z", "]"}]}], "}"}], ",", "Simplify"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"FinalEq2", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"CompactEq2", "/", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"CompactEq2", ",", 
       RowBox[{
        RowBox[{"f", "''"}], "[", "z", "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "''"}], "[", "z", "]"}], ",", 
      RowBox[{
       RowBox[{"f", "'"}], "[", "z", "]"}]}], "}"}], ",", "Simplify"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"FinalConstraint", "=", 
  RowBox[{"CompactConstraint", "*", "8", 
   SuperscriptBox["L", "2"]}]}], "\[IndentingNewLine]", 
 RowBox[{"FinalEq4", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"CompactEq4", "/", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"CompactEq4", ",", 
       RowBox[{
        RowBox[{"\[Eta]", "''"}], "[", "z", "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "''"}], "[", "z", "]"}], ",", 
      RowBox[{
       RowBox[{"\[Eta]", "'"}], "[", "z", "]"}]}], "}"}], ",", "Simplify"}], 
   "]"}]}]}], "Input"]}, Closed]],

Cell[CellGroupData[{

Cell["Around AdS Boundary (z=-1)", "Section"],

Cell["\<\
We analyze the asymptotic behavior of our equations around z=-1 (i.e \[Rho] \
\[LongRightArrow] -\[Infinity])\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CoeffA", "=", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"FinalEq1", ",", 
        RowBox[{
         RowBox[{"A", "'"}], "[", "z", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"A", "''"}], "[", "z", "]"}], "+", 
        RowBox[{"CoeffA", "*", 
         RowBox[{
          RowBox[{"A", "'"}], "[", "z", "]"}]}]}], "==", "0"}], ",", 
      RowBox[{"A", "[", "z", "]"}], ",", "z"}], "]"}], "/.", 
    RowBox[{
     TemplateBox[{"2"},
      "C"], "->", "a0"}]}], "/.", 
   RowBox[{
    TemplateBox[{"1"},
     "C"], "->", 
    RowBox[{"-", "1"}]}]}], "//", "Flatten"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"a0", "-", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "z"}], "]"}]}], "/.", 
    RowBox[{"z", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[Rho]", "-", "\[Rho]h"}], "L"]]}], 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[Rho]", "-", "\[Rho]h"}], "L"]]}]]}]}], "//", 
   "FullSimplify"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Rho]", "\[Element]", "Reals"}], ",", 
     RowBox[{"\[Rho]h", "\[Element]", "Reals"}], ",", 
     RowBox[{"L", ">", "0"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"%", "/.", 
          RowBox[{"\[Rho]", "->", 
           RowBox[{"L", " ", 
            RowBox[{"Log", "[", "x", "]"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "/.", 
      RowBox[{"x", "->", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox["\[Rho]", "L"]]}]}], "/.", 
     RowBox[{"a0", "->", 
      RowBox[{
       RowBox[{"Log", "[", "2", "]"}], "+", "a0"}]}]}], "//", 
    "FullSimplify"}]}], "]"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Coefff", "=", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"FinalEq2", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "'"}], "[", "z", "]"}], "->", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"a0", "-", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "+", "z"}], "]"}]}], ",", "z"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"f", "'"}], "[", "z", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"f", "''"}], "[", "z", "]"}], "+", 
        RowBox[{"Coefff", "*", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "z", "]"}]}]}], "==", "0"}], ",", 
      RowBox[{"f", "[", "z", "]"}], ",", "z"}], "]"}], "/.", 
    RowBox[{
     TemplateBox[{"2"},
      "C"], "->", 
     RowBox[{
      RowBox[{
       FractionBox["1", "3"], 
       TemplateBox[{"1"},
        "C"]}], "+", 
      TemplateBox[{"2"},
       "C"]}]}]}], "//", "FullSimplify"}], "//", "Flatten"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["f3", "3"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", "f1"}], "/.", 
    RowBox[{"z", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[Rho]", "-", "\[Rho]h"}], "L"]]}], 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[Rho]", "-", "\[Rho]h"}], "L"]]}]]}]}], "//", "Simplify"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"%", "/.", 
        RowBox[{"\[Rho]", "->", 
         RowBox[{"L", " ", 
          RowBox[{"Log", "[", "x", "]"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"x", "->", 
     RowBox[{"Exp", "[", 
      FractionBox["\[Rho]", "L"], "]"}]}]}], "/.", 
   RowBox[{"f3", "->", 
    RowBox[{
     FractionBox["3", "8"], "f3"}]}]}], "//", "FullSimplify"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CoefEtaPrime", "=", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FinalEq4", "/.", 
          RowBox[{
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Eta]", "[", "z", "]"}], 
             SqrtBox["3"]], "]"}], "->", 
           RowBox[{"Normal", "[", 
            RowBox[{"Series", "[", 
             RowBox[{
              RowBox[{"Sin", "[", 
               FractionBox[
                RowBox[{"\[Eta]", "[", "z", "]"}], 
                SqrtBox["3"]], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Eta]", "[", "z", "]"}], ",", "0", ",", "1"}], 
               "}"}]}], "]"}], "]"}]}]}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "'"}], "[", "z", "]"}], "->", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"a", "-", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "+", "z"}], "]"}]}], ",", "z"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[Eta]", "'"}], "[", "z", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CoefEta", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FinalEq4", "/.", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox[
              RowBox[{"\[Eta]", "[", "z", "]"}], 
              SqrtBox["3"]], "]"}], "->", 
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{"Sin", "[", 
                FractionBox[
                 RowBox[{"\[Eta]", "[", "z", "]"}], 
                 SqrtBox["3"]], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Eta]", "[", "z", "]"}], ",", "0", ",", "1"}], 
                "}"}]}], "]"}], "]"}]}]}], "/.", 
          RowBox[{
           RowBox[{
            RowBox[{"A", "'"}], "[", "z", "]"}], "->", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"a", "-", 
              RowBox[{"Log", "[", 
               RowBox[{"1", "+", "z"}], "]"}]}], ",", "z"}], "]"}]}]}], ",", 
         RowBox[{"\[Eta]", "[", "z", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"-", "1"}], "]"}], "->", "1"}]}], "//", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "''"}], "[", "z", "]"}], "+", 
