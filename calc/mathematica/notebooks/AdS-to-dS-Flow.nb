         RowBox[{
          RowBox[{"\[Eta]", "[", "0", "]"}], "->", "\[Eta]H"}]}], "}"}]}], ",", 
      RowBox[{"\[Epsilon]", "=", "cutoff"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "0"}], ",", 
       RowBox[{"i", "<=", "ord"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
