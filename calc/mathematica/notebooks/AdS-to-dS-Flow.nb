         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "'"}], "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{
           RowBox[{"fSeries", "'"}], "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Eta]", "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{"\[Eta]Series", "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Eta]", "'"}], "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{
           RowBox[{"\[Eta]Series", "'"}], "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"A", "[", "\[Epsilon]", "]"}], "==", 
          RowBox[{"ASeries", "[", "\[Epsilon]", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "'"}], "[", "\[Epsilon]", "]"}], "==", 
