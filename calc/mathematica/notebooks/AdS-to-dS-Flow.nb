     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FinalEq1", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FinalEq2", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FinalEq4", "==", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"f", "[", "\[Epsilon]", "]"}], "==", 
