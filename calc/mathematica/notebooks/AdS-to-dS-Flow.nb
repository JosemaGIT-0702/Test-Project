Cell[TextData[{
 "We would like f[-1]=1 and consequently (see Eq. 2) A[-1] \[LongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["\[Rho]", "L"]}], TraditionalForm]]],
 " = -Log[1+z], so we make a change of coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "_"], "=", 
    FractionBox["\[Rho]", 
     SqrtBox[
      RowBox[{"f", "[", 
