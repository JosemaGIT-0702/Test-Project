                  RowBox[{"SeriesHorizonConstraint", "==", "0"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"f", "''"}], "[", "0", "]"}], ",", 
