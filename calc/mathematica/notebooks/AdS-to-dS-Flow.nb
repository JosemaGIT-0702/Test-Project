Cell[CellGroupData[{

Cell["Thermodynamics", "Chapter"],

Cell["\<\
We can now use the previous results as the starting point and obtain a \
numerical solution.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NumericalSolAdSv2", "[", 
   RowBox[{
    RowBox[{"\[Eta]H_", "?", "NumericQ"}], ",", 
    RowBox[{"f1_", "?", "NumericQ"}], ",", 
    RowBox[{"A0_", "?", "NumericQ"}], ",", 
    RowBox[{"ord_", "?", "IntegerQ"}], ",", 
    RowBox[{"cutoff_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TotalConditions", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", "0", "]"}], "->", "0"}], ",", 
         RowBox[{
          RowBox[{"\[Eta]", "[", "0", "]"}], "->", "\[Eta]H"}]}], "}"}]}], ",", 
      RowBox[{"\[Epsilon]", "=", "cutoff"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "0"}], ",", 
       RowBox[{"i", "<=", "ord"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SeriesHorizonEq1", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{"FinalEq1", ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "i"}], "}"}]}], "]"}], "/.", 
           "TotalConditions"}], "//", "Normal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"SeriesHorizonEq2", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{"FinalEq2", ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "i"}], "}"}]}], "]"}], "/.", 
           "TotalConditions"}], "//", "Normal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"SeriesHorizonConstraint", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{"FinalConstraint", ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "0"}], "}"}]}], "]"}], "/.", 
           "TotalConditions"}], "//", "Normal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"SeriesHorizonEq4", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"f", "[", "z", "]"}], "FinalEq4"}], "//", 
              "FullSimplify"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "i"}], "}"}]}], "]"}], "/.", 
           "TotalConditions"}], "//", "Normal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"TotalConditions", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"TotalConditions", ",", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"SeriesHorizonEq1", "==", "0"}], ",", 
                  RowBox[{"SeriesHorizonEq2", "==", "0"}], ",", 
                  RowBox[{"SeriesHorizonEq4", "==", "0"}], ",", 
                  RowBox[{"SeriesHorizonConstraint", "==", "0"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"f", "''"}], "[", "0", "]"}], ",", 
                  RowBox[{
                   RowBox[{"A", "'"}], "[", "0", "]"}], ",", 
                  RowBox[{
                   RowBox[{"A", "''"}], "[", "0", "]"}], ",", 
                  RowBox[{
                   RowBox[{"\[Eta]", "'"}], "[", "0", "]"}]}], "}"}]}], "]"}],
               "//", "Flatten"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"TotalConditions", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"TotalConditions", ",", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"SeriesHorizonEq1", "==", "0"}], ",", 
                  RowBox[{"SeriesHorizonEq2", "==", "0"}], ",", 
                  RowBox[{"SeriesHorizonEq4", "==", "0"}]}], "}"}], ",", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{
                   SuperscriptBox["\[Eta]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", "0", "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["A", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"i", "+", "2"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", "0", "]"}], ",", " ", 
                  RowBox[{
                   SuperscriptBox["f", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"i", "+", "2"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", "0", "]"}]}], "}"}]}], 
               "]"}], "//", "Flatten"}]}], "]"}]}]}], "\[IndentingNewLine]", 
         "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"FinalEq1", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FinalEq2", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FinalEq4", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"f", "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"Normal", "[", 
              RowBox[{"Series", "[", 
               RowBox[{
                RowBox[{"f", "[", "z", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "0", ",", 
                  RowBox[{"ord", "+", "2"}]}], "}"}]}], "]"}], "]"}]}], "/.", 
            "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Eta]", "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"Normal", "[", 
              RowBox[{"Series", "[", 
               RowBox[{
                RowBox[{"\[Eta]", "[", "z", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "0", ",", 
                  RowBox[{"ord", "+", "1"}]}], "}"}]}], "]"}], "]"}]}], "/.", 
            "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"Normal", "[", 
              RowBox[{"Series", "[", 
               RowBox[{
                RowBox[{"A", "[", "z", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"z", ",", "0", ",", 
                  RowBox[{"ord", "+", "2"}]}], "}"}]}], "]"}], "]"}]}], "/.", 
            "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"f", "'"}], "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"f", "[", "z", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"z", ",", "0", ",", 
                    RowBox[{"ord", "+", "2"}]}], "}"}]}], "]"}], "]"}], ",", 
               "z"}], "]"}]}], "/.", "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Eta]", "'"}], "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"\[Eta]", "[", "z", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"z", ",", "0", ",", 
                    RowBox[{"ord", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
               "z"}], "]"}]}], "/.", "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"A", "'"}], "[", "\[Epsilon]", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"A", "[", "z", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"z", ",", "0", ",", 
                    RowBox[{"ord", "+", "2"}]}], "}"}]}], "]"}], "]"}], ",", 
               "z"}], "]"}]}], "/.", "TotalConditions"}], "/.", 
           RowBox[{"z", "->", "\[Epsilon]"}]}]}], "\[IndentingNewLine]", 
         "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", "0", "]"}], "->", "A0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "'"}], "[", "0", "]"}], "->", "f1"}]}], "}"}]}], 
       "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", "f", ",", "A"}], "}"}], "\[IndentingNewLine]", 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Epsilon]"}], ",", 
         RowBox[{"-", "\[Epsilon]"}]}], "}"}], "\[IndentingNewLine]", ",", 
       RowBox[{"WorkingPrecision", "->", "50"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input"],

